# MJImage Production Environment Variables Example
NODE_ENV=production
PORT=3000

# Security & Limits
NEXT_PUBLIC_APP_URL=https://mjimage.com
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_DIMENSION_PX=8000
MAX_CONCURRENT_JOBS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Ephemeral File Retention (in milliseconds, 15 minutes default)
TEMP_FILE_TTL_MS=900000

# AdSense Publisher ID (Optional, placeholder active if omitted)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
